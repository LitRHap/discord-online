# ===== Login =====
DISCORD_LOGIN=
DISCORD_PASSWORD=
# Opsional: token (melewati login password)
DISCORD_TOKEN=

# ===== Status =====
# online | idle | dnd | invisible
STATUS=online

# ===== Presence tunggal (kosongkan semua jika pakai presence.json) =====
# PLAYING | WATCHING | LISTENING | COMPETING | STREAMING | CUSTOM
PRESENCE_TYPE=PLAYING
PRESENCE_NAME=Minecraft
PRESENCE_DETAILS=Bertahan hidup di server
PRESENCE_STATE=Lantai 3
# Wajib jika STREAMING: link Twitch/YouTube
STREAM_URL=
# Gambar: link langsung (https, .png/.jpg/.gif/.webp). Lihat README untuk tempat hosting
LARGE_IMAGE=
LARGE_TEXT=
SMALL_IMAGE=
SMALL_TEXT=
# Tombol (maks 2)
BUTTON1_LABEL=
BUTTON1_URL=
BUTTON2_LABEL=
BUTTON2_URL=
# Timer "elapsed" sejak bot menyala
SHOW_ELAPSED=true
# Custom status (teks + emoji) yang tampil bersama aktivitas
CUSTOM_STATUS_TEXT=
CUSTOM_STATUS_EMOJI=

# ===== Rotasi =====
# Dipakai jika presence.json ada. Minimal 15 detik
ROTATE_SECONDS=30
PRESENCE_FILE=presence.json

# Opsional: Application ID (17-19 digit) dari discord.com/developers. Boleh dikosongkan
APPLICATION_ID=

PORT=
LOG_LEVEL=info
